<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     FirstFuse Server — logback-spring.xml
     dev  ：彩色 console（本地开发看舒服）
     prod ：JSON console（接 ELK/Loki 方便结构化查询）
     生产文件落地留给外部采集（NAS 上用 docker logs 或 sidecar）
     ============================================================ -->
<configuration>

    <!-- ==================== 公共：彩色 pattern ==================== -->
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%blue(%thread)] %cyan(%logger{30}) : %msg%n"/>

    <!-- ==================== 开发环境：彩色 console ==================== -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
            </encoder>
        </appender>

        <logger name="com.chuangrongtong.firstfuse" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.springframework" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ==================== 生产环境：JSON console ==================== -->
    <springProfile name="prod | docker">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- 去掉不需要的字段 -->
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
                <customFields>{"app":"firstfuse-server","env":"${SPRING_PROFILES_ACTIVE:-prod}"}</customFields>
            </encoder>
        </appender>

        <logger name="com.chuangrongtong.firstfuse" level="INFO" additivity="false">
            <appender-ref ref="JSON"/>
        </logger>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <!-- ==================== 默认（兜底）：INFO + console ==================== -->
    <springProfile name="!dev &amp; !prod &amp; !docker">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{30} : %msg%n</pattern>
            </encoder>
        </appender>

        <logger name="com.chuangrongtong.firstfuse" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
